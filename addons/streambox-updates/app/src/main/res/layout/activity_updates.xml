<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="28dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="620dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/glass_panel"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="18dp"
        android:elevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="2dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:fontFamily="@font/outfit_medium" />

            <LinearLayout
                android:id="@+id/storage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/row_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_storage"
                    android:tint="@drawable/pill_text"
                    android:duplicateParentState="true"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical"
                    android:duplicateParentState="true">

                    <TextView
                        android:id="@+id/storageText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@drawable/pill_text"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit_regular"
                        android:duplicateParentState="true" />

                    <ProgressBar
                        android:id="@+id/storageBar"
                        style="@android:style/Widget.Material.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="3dp"
                        android:max="100"
                        android:progressDrawable="@drawable/storage_bar"
                        android:progressTint="@drawable/pill_text"
                        android:progressBackgroundTint="@drawable/storage_track"
                        android:duplicateParentState="true" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:textColor="#D9FFFFFF"
            android:textSize="15sp"
            android:lineSpacingExtra="3sp"
            android:fontFamily="@font/outfit_regular" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:requiresFadingEdge="vertical"
            android:fadingEdgeLength="20dp">

            <LinearLayout
                android:id="@+id/rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:id="@+id/removeMode" style="@style/Pill" android:layout_marginStart="0dp" android:visibility="gone" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <TextView android:id="@+id/close" style="@style/Pill" android:text="@string/close" />
            <TextView android:id="@+id/updateAll" style="@style/Pill" android:text="@string/update_all" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
