<?xml version="1.0" encoding="utf-8"?>
<!-- TvDialog: the launcher's menus and questions. The outer frame keeps a long list off the screen's edges. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="28dp"
    android:paddingBottom="28dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/glass_panel"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="18dp"
        android:elevation="12dp">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="-0.01" />

        <!-- Takes what height is left, so a long list scrolls and the buttons stay on screen. -->
        <FrameLayout
            android:id="@+id/dialogContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/dialogScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:requiresFadingEdge="vertical"
                android:fadingEdgeLength="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/dialogMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:textColor="#D9FFFFFF"
                        android:textSize="15sp"
                        android:lineSpacingExtra="3sp"
                        android:fontFamily="@string/font_regular" />

                    <LinearLayout
                        android:id="@+id/dialogRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <FrameLayout
                        android:id="@+id/dialogView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/dialogButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="end">

            <TextView android:id="@+id/dialogNeutral" style="@style/TopButton" />
            <TextView android:id="@+id/dialogNegative" style="@style/TopButton" />
            <TextView android:id="@+id/dialogPositive" style="@style/TopButton" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
